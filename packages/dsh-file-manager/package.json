{
  "name": "@dsh-external/dsh-file-manager",
  "version": "0.1.1",
  "description": "Authenticated Web file tree and directory management",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "bash ../../scripts/build.sh",
    "typecheck": "bash ../../scripts/typecheck.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@dsh-external/dsh-right-sidebar",
        "@dsh-external/dsh-user-files",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/schemastery": ">=3.18.2 <4",
    "@dsh-external/dsh-right-sidebar": ">=0.0.2 <1",
    "react": "^18.2.0",
    "@dsh-external/dsh-user-files": "^0.1.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.2 <1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.2-alpha.2 <1"
  },
  "dependencies": {
    "trash": "^10.0.0",
    "wsl-utils": "^0.4.0",
    "xdg-trashdir": "^3.1.0",
    "zod": "^4.4.3"
  }
}
